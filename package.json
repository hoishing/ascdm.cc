{
  "name": "ascdm-cc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "webapps/*"
  ],
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "dev:ai-session-dashbaord": "bun --filter ai-session-dashbaord dev",
    "dev:domain-searcher": "bun --filter domain-searcher dev",
    "dev:ppt-doc-compressor": "bun --filter ppt-doc-compressor dev",
    "dev:web-authenticator": "bun --filter web-authenticator dev",
    "dev:xmp-editor": "bun --filter xmp-editor dev",
    "build": "bun run build:static",
    "build:static": "bun run build:webapps && bun run assemble:static",
    "build:webapps": "bun --workspaces --sequential run build",
    "assemble:static": "uv run scripts/assemble_static.py",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
